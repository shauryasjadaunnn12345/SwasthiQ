# Copy to .env and fill in, or export these directly in your shell / host's
# environment settings. manage.py does not auto-load .env -- either use
# `django-environ`/`python-dotenv` yourself, or export these before running.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# Mistral "La Plateforme" free-tier key: https://console.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
